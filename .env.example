# Copy this file to ".env" and change the secret.

# Port the server runs on
PORT=3000

# Secret used to sign login tokens. Use any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: directory for persistent data. When set, the SQLite database
# (data.db) and uploaded PDFs (uploads/) are stored here instead of in the
# project folder. On a host like Render, point this at a mounted disk so data
# survives restarts and redeploys (see DEPLOY.md). Left unset, both live in the
# project folder, which is right for local development.
# DATA_DIR=/data

# Optional: only set this if you host the API on a different origin than the
# frontend. When set, cross-origin requests from this origin are allowed.
# Left unset, CORS stays off (frontend + API share one origin).
# Native mobile (React Native / Expo Go) does NOT need this; only a browser
# (e.g. Expo web) hitting the API from another origin does.
# CORS_ORIGIN=https://erp.yourschool.example
